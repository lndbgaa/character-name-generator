{
  "name": "server",
  "version": "1.0.0",
  "main": "./dist/app.js",
  "type": "module",
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && cp -r src/templates dist/templates",
    "start": "node ./dist/app.js",
    "preview": "npm run build && npm run start",
    "dev": "tsx watch ./src/app.ts",
    "debug": "tsx watch --inspect ./src/app.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:build:names:mysql": "tsx ./scripts/createNamesSQLSeedFile.ts",
    "db:init:mysql": "npm run db:build:names:mysql && tsx ./scripts/initMySQLDatabase.ts",
    "db:reset:mysql": "npm run db:build:names:mysql && tsx ./scripts/resetMySQLDatabase.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "chalk": "^5.4.1",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.5",
    "mysql2": "^3.14.2",
    "nanoid": "^5.1.5",
    "sequelize": "^6.37.7",
    "tsx": "^4.20.3",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "@types/sequelize": "^4.28.20",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3"
  }
}
